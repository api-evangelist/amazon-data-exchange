{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS Data Exchange Assets API",
    "version": "2017-07-25"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Revision Assets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dataexchange.amazonaws.com/v1/data-sets/:DataSetId/revisions/:RevisionId/assets",
            "params": [
              {
                "name": "DataSetId",
                "value": "",
                "type": "path"
              },
              {
                "name": "RevisionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "maxResults",
                "value": "",
                "type": "query"
              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of assets in a specific revision."
        },
        {
          "info": {
            "name": "Get Asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dataexchange.amazonaws.com/v1/data-sets/:DataSetId/revisions/:RevisionId/assets/:AssetId",
            "params": [
              {
                "name": "DataSetId",
                "value": "",
                "type": "path"
              },
              {
                "name": "RevisionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "AssetId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the details of a specific asset."
        },
        {
          "info": {
            "name": "Update Asset",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://dataexchange.amazonaws.com/v1/data-sets/:DataSetId/revisions/:RevisionId/assets/:AssetId",
            "params": [
              {
                "name": "DataSetId",
                "value": "",
                "type": "path"
              },
              {
                "name": "RevisionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "AssetId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the name of a specific asset."
        },
        {
          "info": {
            "name": "Delete Asset",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://dataexchange.amazonaws.com/v1/data-sets/:DataSetId/revisions/:RevisionId/assets/:AssetId",
            "params": [
              {
                "name": "DataSetId",
                "value": "",
                "type": "path"
              },
              {
                "name": "RevisionId",
                "value": "",
                "type": "path"
              },
              {
                "name": "AssetId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes an asset from a revision."
        }
      ]
    }
  ],
  "bundled": true
}